{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "/home/YOUR_USERNAME/.claude/hooks/block-artifact.py"
            ],
            "timeout": 15,
            "statusMessage": "Blocking Artifact - use make-brief + local HTML instead..."
          }
        ]
      }
    ]
  }
}
